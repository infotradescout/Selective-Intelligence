{
  "id": "si.execution",
  "version": "0.1.0",
  "purpose": "Build the slice to match the locked plan, in an isolated worktree.",
  "owns": ["changed_files", "build_artifacts", "behaviors_enabled"],
  "triggers": ["plan_accepted"],
  "inputs": [
    { "name": "checkpoint", "type": "string", "required": true },
    { "name": "task_plan", "type": "array", "required": true }
  ],
  "outputs": [
    { "name": "files", "type": "object" },
    { "name": "behaviors_enabled", "type": "array" },
    { "name": "proof", "type": "string" },
    { "name": "open_failures", "type": "array" }
  ],
  "dependencies": ["si.planning"],
  "capabilities": ["model", "filesystem", "git"],
  "requires": ["reasoning", "code_generation", "structured_output", "filesystem_write"],
  "subskill": "subskills/si-worker/ROLE.md",
  "permissions": {
    "filesystem": "write-scoped",
    "shell": true,
    "git": "worktree",
    "network": "restricted",
    "secrets": "reference-only"
  },
  "contextPolicy": { "scope": "lane-local", "includes": ["plan", "repository-scope"] },
  "agentPolicy": {
    "defaultAgents": 1,
    "maximumAgents": 4,
    "roles": ["implementer", "reviewer", "verifier"],
    "spawnConditions": ["repeated_verification_failure", "high_risk_change", "excessive_scope"]
  },
  "isolationPolicy": {
    "requiresWorktree": true,
    "branchPattern": "run/<session-id>/<feature-id>/<lane-id>",
    "writableScopes": ["src/**"]
  },
  "completionGates": [
    "files produced",
    "relevant build passes",
    "no undeclared file ownership violation",
    "handoff artifact produced"
  ],
  "verificationPolicy": { "depth": "targeted-tests" },
  "repairPolicy": { "maxAttempts": 3, "onRepeatedFailure": "add-diagnostic-agent" },
  "humanBlockerPolicy": { "continueIndependentWork": true, "requireExactInstructions": true },
  "compatibility": { "upstream": ["si.planning"], "downstream": ["si.verification", "si.integration"] }
}
