{
  "id": "si.planning",
  "version": "0.1.0",
  "purpose": "Lock the first-checkpoint plan in plain language before any building.",
  "owns": ["checkpoint", "task_plan", "human_actions", "go_no_go"],
  "triggers": ["build_request"],
  "inputs": [
    { "name": "idea", "type": "string", "required": true },
    { "name": "project_context", "type": "object", "required": false }
  ],
  "outputs": [
    { "name": "checkpoint", "type": "string" },
    { "name": "task_plan", "type": "array" },
    { "name": "human_actions", "type": "array" },
    { "name": "go_no_go", "type": "string" }
  ],
  "dependencies": [],
  "capabilities": ["model"],
  "requires": ["reasoning", "structured_output"],
  "subskill": "subskills/si-planner/ROLE.md",
  "permissions": {
    "filesystem": "read",
    "shell": false,
    "git": "none",
    "network": "restricted",
    "secrets": "reference-only"
  },
  "contextPolicy": { "scope": "feature", "includes": ["idea", "requirements", "architecture"] },
  "agentPolicy": {
    "defaultAgents": 1,
    "maximumAgents": 2,
    "roles": ["planner"],
    "spawnConditions": ["confidence_below_threshold"]
  },
  "isolationPolicy": { "requiresWorktree": false, "writableScopes": [] },
  "completionGates": [
    "checkpoint produced in plain language",
    "human_actions enumerated up front",
    "go_no_go decided"
  ],
  "verificationPolicy": { "depth": "none" },
  "humanBlockerPolicy": { "continueIndependentWork": true, "requireExactInstructions": true },
  "compatibility": { "upstream": ["si.discovery"], "downstream": ["si.execution"] }
}
