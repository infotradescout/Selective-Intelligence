{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Selective Intelligence Council Completion Review",
  "description": "Registered bridge artifact. scripts/start_pack.py is authoritative for Council packet, byte-digest, lineage, role-independence, and requirement-proof checks.",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "binding",
    "case_packet_id",
    "case_digest",
    "alignment_packet_id",
    "alignment_digest",
    "requirement_proofs",
    "case"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "enum": ["pending", "verified", "failed"] },
    "binding": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["project_id", "release_id", "release_version", "build_id", "lock_version", "source_revision", "semantic_digest", "validator_version", "requirement_ids"],
          "properties": {
            "project_id": { "$ref": "#/$defs/id" },
            "release_id": { "$ref": "#/$defs/id" },
            "release_version": { "type": "string", "minLength": 1 },
            "build_id": { "$ref": "#/$defs/id" },
            "lock_version": { "type": "string", "minLength": 1 },
            "source_revision": { "type": "string", "minLength": 2 },
            "semantic_digest": { "$ref": "#/$defs/digest" },
            "validator_version": { "type": "string", "minLength": 1 },
            "requirement_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
          },
          "additionalProperties": false
        }
      ]
    },
    "case_packet_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "case_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "alignment_packet_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "alignment_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "requirement_proofs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement_id", "proof_ids", "receipt_ids"],
        "properties": {
          "requirement_id": { "$ref": "#/$defs/id" },
          "proof_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
          "receipt_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
        },
        "additionalProperties": false
      }
    },
    "case": { "oneOf": [{ "type": "object" }, { "type": "null" }] }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
