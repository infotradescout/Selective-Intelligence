{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Selective Intelligence Structured Observation Receipts",
  "description": "Registered machine-readable receipts used by the Start Pack positive-completion bridge. scripts/start_pack.py is authoritative for cross-artifact byte and identity checks.",
  "type": "object",
  "required": ["schema_version", "receipts"],
  "properties": {
    "schema_version": { "const": 1 },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "receipt_id", "run_id", "proof_id", "requirement_id", "source_revision",
          "evidence_type", "procedure", "expected", "observed", "verdict",
          "exit_code", "observed_at", "output_path", "output_digest"
        ],
        "properties": {
          "receipt_id": { "$ref": "#/$defs/id" },
          "run_id": { "$ref": "#/$defs/id" },
          "proof_id": { "$ref": "#/$defs/id" },
          "requirement_id": { "$ref": "#/$defs/id" },
          "source_revision": { "type": "string", "minLength": 2 },
          "evidence_type": { "enum": ["automated_test", "manual_observation", "artifact_inspection", "runtime_trace"] },
          "procedure": { "type": "string", "minLength": 1 },
          "expected": { "type": "string", "minLength": 1 },
          "observed": { "type": "string", "minLength": 1 },
          "verdict": { "enum": ["passed", "failed", "partial", "blocked", "unverifiable"] },
          "exit_code": { "type": "integer" },
          "observed_at": { "type": "string", "format": "date-time" },
          "output_path": { "$ref": "#/$defs/relativePath" },
          "output_digest": { "$ref": "#/$defs/digest" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$" },
    "relativePath": { "type": "string", "minLength": 1, "not": { "pattern": "^(?:[A-Za-z]:|/|\\\\|.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))" } },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
